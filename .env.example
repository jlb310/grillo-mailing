# Variables de entorno de Grillo Mailing.
#
# En producción se cargan en Dokploy, NO desde un archivo. Ojo con eso: la lista
# `environment:` de docker-compose.yml funciona como lista blanca — una variable
# definida en Dokploy pero ausente de esa lista nunca llega al contenedor y falla
# en silencio. Si agregas una variable nueva acá, agrégala también allá.

# ── Base de datos ────────────────────────────────────────────────────────────
# Postgres corre como servicio aparte en Dokploy (grillo-mailing-db), alcanzable
# por hostname dentro de dokploy-network.
DATABASE_URL=postgresql://usuario:password@grillo-mailing-db:5432/mailing

# ── Sesión y URL pública ─────────────────────────────────────────────────────
# Cadena aleatoria larga. Rotarla cierra todas las sesiones abiertas.
NEXTAUTH_SECRET=
# URL pública, sin barra final. De acá salen el endpoint del webhook, los links
# de baja y el "ver en el navegador" de cada campaña. Si no coincide con el
# dominio real, Resend entrega los eventos en una URL que nadie escucha.
NEXTAUTH_URL=https://correo.grillo.click

# ── Cuenta Resend de Grillo (la suscripción que Grillo paga) ─────────────────
# API key de la cuenta de Grillo. Es la que envía por TODAS las empresas que no
# tienen cuenta propia — incluidas las que usan su propio dominio.
RESEND_API_KEY=

# Remitente por defecto: solo para empresas sin dominio propio configurado.
# El dominio de esta dirección debe estar verificado en la cuenta de arriba.
RESEND_FROM=Grillo <no-reply@grillo.click>

# Signing secret del webhook de la cuenta de Grillo (whsec_...). Sin esto los
# eventos de apertura/clic/rebote llegan pero se rechazan con 400, y las métricas
# quedan en cero para siempre. Ver CREATE_RESEND_WEBHOOK para obtenerlo.
SVIX_SECRET=

# Solo para dar de alta una cuenta Resend nueva. Con "1", el script del
# entrypoint crea el webhook en el arranque e imprime su signing secret en el
# log UNA vez. Copiar ese valor a SVIX_SECRET, vaciar esta variable y volver a
# deployar: el script pasa a confirmar en cada deploy que ambos coinciden.
CREATE_RESEND_WEBHOOK=

# Destinatarios de los correos de operación (Envío completado, Estadísticas 24h)
# cuando la campaña no define los suyos. Separados por coma.
REPORT_FALLBACK_EMAILS=hola@grillo.click

# ── Cifrado en reposo ────────────────────────────────────────────────────────
# base64 de 32 bytes:  openssl rand -base64 32
#
# NO LA ROTES al cambiar de cuenta Resend. Cifra las credenciales que los
# clientes pegan en la app (recuperable: se vuelven a pegar) y el token de cada
# link de baja, que viaja dentro de los correos ya enviados (NO recuperable:
# cambiarla rompe el link de baja de toda campaña que siga en una bandeja).
ENCRYPTION_KEY=

# ── Usuarios que crea prisma/setup.js en el arranque ─────────────────────────
# Password del super admin (admin@grillo.click). Default: grillo2026.
ADMIN_PASSWORD=
# Admin de la empresa Lenyes. Sin estas tres solo existe el super admin.
LENYES_ADMIN_EMAIL=
LENYES_ADMIN_PASSWORD=
LENYES_ADMIN_NAME=

# ── Opcional ─────────────────────────────────────────────────────────────────
# Raíz de los archivos subidos (logos, programas, productos). El default,
# <cwd>/public, es el que coincide con los volúmenes del compose: solo defínela
# si mueves esos volúmenes de lugar.
# UPLOADS_PATH=
