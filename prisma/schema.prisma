generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  role      AdminRole  @default(ADMIN)
  empresaId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Empresa {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns     Campaign[]
  contacts      Contact[]
  surveys       Survey[]
  contactGroups ContactGroup[]
  admins        AdminUser[]
}

model Campaign {
  id            String         @id @default(cuid())
  empresaId     String
  subject       String
  htmlBody      String         @db.Text
  emailTitle    String?
  emailSubtitle String?
  emailDate     String?
  emailLocation String?
  emailBody     String?        @db.Text
  ctaText       String?
  ctaUrl        String?
  logoUrl         String?
  logoHeight      String?
  logoAlign       String?
  logoRightUrl    String?
  logoRightHeight String?
  logoRight2Url   String?
  logoRight2Height String?
  headerColor   String?
  footerText    String?        @db.Text
  blocks        Json?
  ctaButtons    Json?
  programaUrl   String?
  iconDate      String?
  iconLinkText  String?
  iconLinkUrl   String?
  useAlemanaFooter Boolean      @default(true)
  eventInfoButtons Boolean      @default(false)
  notifyEmails  String[]
  status        CampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  sentAt        DateTime?
  // Whether Resend open/click tracking was actually active when this campaign
  // was sent. null = not sent yet (or legacy/unknown); false = sent without
  // tracking, so its 0 opens/clicks mean "not measured", not "nobody engaged".
  openTrackingAtSend  Boolean?
  clickTrackingAtSend Boolean?
  // When the 24h post-send stats report (opens/clicks) was emailed to
  // notifyEmails. null = not yet due or feature-backfilled; see scheduler.
  statsReportSentAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  scheduledSends ScheduledSend[]
  sendLogs       SendLog[]
  contactGroups  ContactGroup[]  @relation("CampaignGroups")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

model Contact {
  id           String   @id @default(cuid())
  empresaId    String
  email        String
  name         String
  unsubscribed Boolean  @default(false)
  bounced      Boolean  @default(false)
  createdAt    DateTime @default(now())

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  scheduledSends ScheduledSend[]
  sendLogs       SendLog[]
  surveyTokens   SurveyToken[]
  groups         ContactGroup[]  @relation("ContactGroups")

  @@unique([empresaId, email])
}

model ContactGroup {
  id        String   @id @default(cuid())
  empresaId String
  name      String
  createdAt DateTime @default(now())

  empresa  Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contacts Contact[]  @relation("ContactGroups")
  campaigns Campaign[] @relation("CampaignGroups")

  @@unique([empresaId, name])
}

model ScheduledSend {
  id          String              @id @default(cuid())
  campaignId  String
  contactId   String
  status      ScheduledSendStatus @default(PENDING)
  scheduledAt DateTime
  processedAt DateTime?
  createdAt   DateTime            @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

enum ScheduledSendStatus {
  PENDING
  SENT
  FAILED
}

model SendLog {
  id         String    @id @default(cuid())
  campaignId String
  contactId  String
  resendId   String?
  status     String    @default("sent")
  openedAt   DateTime?
  clickedAt  DateTime?
  bouncedAt  DateTime?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
}

model Survey {
  id        String   @id @default(cuid())
  empresaId String
  title     String
  createdAt DateTime @default(now())

  empresa   Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  questions Question[]
  tokens    SurveyToken[]
}

model Question {
  id       String @id @default(cuid())
  surveyId String
  text     String
  type     String @default("text")
  order    Int    @default(0)

  survey  Survey   @relation(fields: [surveyId], references: [id])
  answers Answer[]
}

model SurveyToken {
  id          String    @id @default(uuid())
  surveyId    String
  contactId   String
  usedAt      DateTime?
  completedAt DateTime?

  survey      Survey       @relation(fields: [surveyId], references: [id])
  contact     Contact      @relation(fields: [contactId], references: [id])
  answers     Answer[]

  @@unique([surveyId, contactId])
}

model Answer {
  id            String   @id @default(cuid())
  surveyTokenId String
  questionId    String
  value         String   @db.Text
  createdAt     DateTime @default(now())

  token    SurveyToken @relation(fields: [surveyTokenId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])
}

// A batch of certificates generated from a single uploaded CSV. The CSV is
// self-contained (activity title, date, recipient name/email, role, hours), so
// certificates are NOT tied to events/contacts. PDFs are regenerated on demand
// (deterministic) rather than stored — the container disk is ephemeral.
model CertificateBatch {
  id           String        @id @default(cuid())
  name         String
  status       BatchStatus   @default(DRAFT)
  scheduledAt  DateTime?
  createdAt    DateTime      @default(now())

  certificates Certificate[]
}

model Certificate {
  id             String            @id @default(cuid())
  batchId        String
  recipientName  String
  recipientEmail String
  role           String
  horas          Int
  activityTitle  String
  activityDate   String
  status         CertificateStatus @default(PENDING)
  sentAt         DateTime?
  resendId       String?
  openedAt       DateTime?
  error          String?
  createdAt      DateTime          @default(now())

  batch CertificateBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@index([resendId])
}

enum CertificateStatus {
  PENDING
  GENERATING
  SENT
  FAILED
}

enum BatchStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  DONE
}
