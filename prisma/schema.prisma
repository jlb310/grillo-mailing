// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum EventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  DROPPED
  DEFERRED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          UserRole  @default(CLIENT)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  campaigns     Campaign[]
  templates     Template[]
  
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  brandColor  String?   @default("#171717")
  // Cuenta de Resend propia del cliente. Ambos van CIFRADOS (lib/crypto):
  // nunca se guardan ni se devuelven en claro. Si están vacíos, la
  // organización usa la cuenta global de la agencia (RESEND_API_KEY).
  resendApiKey        String?
  resendWebhookSecret String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  domains     Domain[]
  contacts    Contact[]
  contactLists ContactList[]
  campaigns   Campaign[]
  templates   Template[]
  
  @@map("organizations")
}

model Domain {
  id             String       @id @default(cuid())
  name           String
  resendDomainId String?      @unique
  status         DomainStatus @default(PENDING)
  spfVerified    Boolean      @default(false)
  dkimVerified   Boolean      @default(false)
  dmarcVerified  Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  campaigns      Campaign[]
  
  @@map("domains")
}

model Contact {
  id             String        @id @default(cuid())
  email          String
  firstName      String?
  lastName       String?
  phone          String?
  company        String?
  metadata       String?       @default("{}")
  unsubscribed   Boolean       @default(false)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lists          ContactListMember[]
  events         EmailEvent[]
  
  @@unique([email, organizationId])
  @@map("contacts")
}

model ContactList {
  id             String        @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  members        ContactListMember[]
  campaigns      Campaign[]
  
  @@map("contact_lists")
}

model ContactListMember {
  id            String      @id @default(cuid())
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactListId String
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  
  @@unique([contactId, contactListId])
  @@map("contact_list_members")
}

model Template {
  id             String        @id @default(cuid())
  name           String
  subject        String
  htmlContent    String
  textContent    String?
  thumbnail      String?
  isPublic       Boolean       @default(false)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  campaigns      Campaign[]
  
  @@map("templates")
}

model Campaign {
  id             String        @id @default(cuid())
  name           String
  subject        String
  htmlContent    String
  textContent    String?
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  fromName       String
  fromEmail      String
  replyTo        String?
  resendBatchId  String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId       String
  domain         Domain        @relation(fields: [domainId], references: [id])
  templateId     String?
  template       Template?     @relation(fields: [templateId], references: [id])
  contactListId  String?
  contactList    ContactList?  @relation(fields: [contactListId], references: [id])
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  events         EmailEvent[]
  
  @@map("campaigns")
}

model EmailEvent {
  id          String    @id @default(cuid())
  type        EventType
  email       String
  timestamp   DateTime
  ip          String?
  userAgent   String?
  link        String?
  country     String?
  city        String?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  createdAt   DateTime  @default(now())
  
  @@map("email_events")
}
